    "@remotion/renderer": "4.0.545",
    "@remotion/three": "4.0.545",
    "@types/react": "^19.2.2",
    "@types/three": "^0.180.0",
    "postprocessing": "6.37.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.545",
    "three": "^0.180.0",
    "typescript": "^5.9.3"
